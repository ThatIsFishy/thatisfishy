---
import Base from '../layouts/Base.astro';
import EntryHead from '../components/EntryHead.astro';
import MainText from '../components/MainText.astro';
import { getPage, noticeOf, getNewPages, coverOf, hasTextNotice } from '../lib/content';

// Every page that has no file of its own (About, Ground rules, Privacy and the pages made in the CMS).
// Each one reads its text from src/content/pages/<id>.md
export async function getStaticPaths() {
  return (await getNewPages()).map((e) => ({ params: { page: e.id }, props: { id: e.id } }));
}
const { id } = Astro.props;
const { data, Content, hasBody, body, headings } = await getPage(id);
const notice = noticeOf(data);
---
<Base title={data.title} description={data.description ?? data.intro} index kind="Page" image={coverOf(data)?.image}
  status={notice ? 'empty' : hasTextNotice(body) ? 'wip' : undefined}>
  <div class="column">
    <h1>{data.title}</h1>
    <EntryHead data={data} body={body} />
    <MainText hasBody={hasBody && !notice} headings={headings} title={data.title}><Content /></MainText>
  </div>
</Base>
