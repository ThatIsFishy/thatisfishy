---
import Base from '../layouts/Base.astro';
import EntryHead from '../components/EntryHead.astro';
import MainText from '../components/MainText.astro';
import { getPage } from '../lib/content';

// The small text pages. Each one reads its text from src/content/pages/<id>.md
export function getStaticPaths() {
  return ['about', 'ground-rules', 'privacy'].map((id) => ({ params: { page: id }, props: { id } }));
}
const { id } = Astro.props;
const { data, Content, hasBody } = await getPage(id);
---
<Base title={data.title} description={data.description ?? data.intro} index kind="Page">
  <div class="column">
    <h1>{data.title}</h1>
    <EntryHead data={data} />
    <MainText hasBody={hasBody}><Content /></MainText>
  </div>
</Base>
