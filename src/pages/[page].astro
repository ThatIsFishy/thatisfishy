---
import Base from '../layouts/Base.astro';
import EntryHead from '../components/EntryHead.astro';
import MainText from '../components/MainText.astro';
import { getPage, noticeOf, getNewPages } from '../lib/content';

// Every page that has no file of its own (About, Ground rules, Privacy and the pages made in the CMS).
// Each one reads its text from src/content/pages/<id>.md
export async function getStaticPaths() {
  return (await getNewPages()).map((e) => ({ params: { page: e.id }, props: { id: e.id } }));
}
const { id } = Astro.props;
const { data, Content, hasBody } = await getPage(id);
const notice = noticeOf(data);
---
<Base title={data.title} description={data.description ?? data.intro} index kind="Page">
  <div class="column">
    <h1>{data.title}</h1>
    <EntryHead data={data} />
    <MainText hasBody={hasBody && !notice}><Content /></MainText>
  </div>
</Base>
