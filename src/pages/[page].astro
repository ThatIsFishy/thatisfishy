---
import Base from '../layouts/Base.astro';
import Break1 from '../components/Break1.astro';
import { getPage } from '../lib/content';

// The small text pages. Each one reads its text from src/content/pages/<id>.md
export function getStaticPaths() {
  return ['about', 'ground-rules', 'privacy'].map((id) => ({ params: { page: id }, props: { id } }));
}
const { id } = Astro.props;
const { data, Content } = await getPage(id);
---
<Base title={data.title} description={data.description} index kind="Page">
  <div class="column">
    <h1>{data.title}</h1>
    {data.description && <div class="lead"><p>{data.description}</p></div>}
    <Break1 />
    <div class="prose"><Content /></div>
  </div>
</Base>
