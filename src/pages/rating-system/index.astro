---
import Base from '../../layouts/Base.astro';
import Break1 from '../../components/Break1.astro';
import { getPage } from '../../lib/content';
import { SHOW_RATING, RATING_COMING_SOON } from '../../consts';

// If the Rating System is switched off in consts.ts, send visitors to the home page.
if (!SHOW_RATING) return Astro.redirect('/');

const { data, Content } = await getPage('rating-system');
---
<Base title={data.title} description={data.description} index={!RATING_COMING_SOON} kind="Page">
  <div class="column">
    <h1>{data.title}</h1>
    <div class="lead"><Content /></div>
    <Break1 />

    {RATING_COMING_SOON && (
      <div class="panel coming">
        <h2>Coming soon</h2>
        <p>The way I rate aquarium shops, written down so you can see exactly how a score is reached. It isn’t ready yet, so check back soon.</p>
      </div>
    )}
  </div>
</Base>
