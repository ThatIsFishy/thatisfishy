---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getPage } from '../../lib/content';

const entries = (await getCollection('journal')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const { data, Content } = await getPage('fishy-stories');
---
<Base title={data.title} description={data.description}>
  <h1>{data.title}</h1>
  <div class="lead"><Content /></div>
  <div class="grid">
    {entries.map((e) => <StoryCard story={e} />)}
  </div>
</Base>
