---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('journal')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Tank journal" description="Real entries from my tank: what I did, what happened, what I would change.">
  <h1>Tank journal</h1>
  <p class="lead">Real entries from my tank: what I did, what happened, what I’d change.</p>
  <div class="grid">
    {entries.map((e) => (
      <a class="card" href={`/journal/${e.id}/`}>
        <div class="tags"><span class="tag">{e.data.date.toISOString().slice(0, 10)}</span></div>
        <h3>{e.data.title}</h3>
        {e.data.description && <p>{e.data.description}</p>}
      </a>
    ))}
  </div>
</Base>
