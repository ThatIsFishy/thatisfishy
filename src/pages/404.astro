---
// The page for a link that leads nowhere ("Page not found", 404). Netlify shows it for every unknown address.
// Title, message and the heading above the cards are edited in the CMS: Special pages > Page not found.
// Not in Google and not in the site search. The search bar opens by itself.
import Base from '../layouts/Base.astro';
import Break1 from '../components/Break1.astro';
import Recommend from '../components/Recommend.astro';
import { introHtml } from '../lib/content';
import page from '../data/not-found.json';

const title = page.title?.trim() || 'This page swam away';
const message = await introHtml(page.message?.trim() || 'The link may be old, or the page moved to another tank.');
const cardsHeading = page.cardsHeading?.trim() || 'While you wait, have a look at';
---
<Base title={title} noindex>
  <div class="column nf">
    <!-- An empty tank with our bubbles, and the builder shrimp next to it wondering where the page went -->
    <svg class="nf-pic" viewBox="0 0 372 175" width="372" height="175" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <rect x="20" y="30" width="200" height="120" rx="14" stroke-width="5" />
        <path d="M22 50 H218" stroke-width="3" />
        <path d="M24 131 Q70 125 120 129 T216 128" stroke-width="3" />
      </g>
      <use href="#bub" x="52" y="88" width="30" height="30" /><use href="#bub" x="74" y="64" width="20" height="20" /><use href="#bub" x="62" y="54" width="13" height="13" />
      <use href="#bub" x="160" y="92" width="24" height="24" /><use href="#bub" x="178" y="72" width="15" height="15" /><use href="#bub" x="120" y="76" width="18" height="18" />
      <g transform="translate(364 72) scale(-1.3 1.3)"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g transform="translate(0 4)"><path d="M38 55.3L34 61L36 65.5M43 55.3L40 61.5L42 65.5M48 53.8L47 60L50 65.5M52.5 50.5L55 57.5L58 65.5" stroke-width="1.7"/><path d="M55 40L61.5 38.3M54.6 46.5L62.5 45" stroke-width="1.7"/><path d="M17.5 54.5C15 56 14.5 58.5 15.5 61M22 55C19.5 56.5 19 59 20 61.5M26.5 55.5C24 57 23.5 59.5 24.5 62M31 56C28.5 57.5 28 60 29 62.5" stroke-width="1.4"/><path d="M68 20C62 11 48 8 41 16C36 24 37 36 40 44C33 48 22 49 14 47L10 40L7 44L5 50L1 55L14 53C22 55 34 56 44 55C52 53 55 46 55 38C55 30 54 24 52 21C58 20 63 20 68 20Z" style="fill:var(--surface)"/><path d="M39.3 28C42.5 28.5 46 30 48.5 32.5M47 41C49 43 50 45 50.3 48.5" stroke-width="1.4"/><path d="M18 48L18.3 54M22.5 48.6L23 54.8M27 48.6L27.6 55.3M31.5 48.2L32 55.7M36 46.5L36.8 55.8" stroke-width="1.4"/><path d="M14 50L9 44M14 50.5L5 50.5M14 51L3 54" stroke-width="1.2"/><g transform="rotate(-7 67.5 35)"><rect x="61" y="25" width="13" height="20" style="fill:var(--surface)"/><path d="M69.5 25L74 29.5M69.5 25V29.5H74" stroke-width="1.4"/></g><circle cx="51.5" cy="19" r="2.5" fill="currentColor"/></g><path d="M68 24C77 19 87 14 97 9M68 24C78 22 90 20.5 99 21" stroke-width="1.2"/><path d="M68 24C72 21 75 19.5 79 18.8M68 24C72 26.5 75.5 27.7 80 28" stroke-width="1.2"/><g transform="translate(0 0)"><path d="M36 15.8C48 18.2 62 17.6 74 14.4C65 12.2 46 12.4 36 15.8Z" style="fill:var(--surface)" stroke-width="1.6"/><path d="M37 14C37 4 45 0.8 52 0.8C60 0.8 65.5 6 65.5 13.5C55 12 45 12 37 14Z" style="fill:var(--surface)" stroke-width="1.8"/><path d="M40.5 12C41.5 6.5 46 3.8 52 3.3C57.5 3.3 62 7 63 12" stroke-width="1.4"/><path d="M42.5 9.5V12M45 7.8V11M60 8V11.5" stroke-width="1.2"/></g></g></g>
      <text x="296" y="58" text-anchor="middle" font-family="Oswald, sans-serif" font-weight="700" font-size="46" fill="currentColor">?</text>
    </svg>
    <h1>{title}</h1>
    <div class="lead nf-text" set:html={message} />
    <div class="actions nf-actions">
      <a class="btn" href="/">Home</a>
      <a class="btn alt" href="/knowledge-center/">Knowledge Center</a>
      <a class="btn alt" href="/fishy-stories/">Fishy Stories</a>
    </div>
    <Break1 />
    <Recommend heading={cardsHeading} />
  </div>
</Base>

<style>
  .nf { text-align: center; }
  .nf-pic { display: block; margin: 5.5rem auto .6rem;   /* room for the open search bar above it */ max-width: 92%; height: auto; color: var(--water); }
  .nf h1 { margin-top: 0; }
  .nf-text { max-width: 36rem; margin: 0 auto; }
  .nf-text :global(p) { text-align: center !important; hyphens: none !important; }
  .nf-actions { justify-content: center; flex-wrap: wrap; }
  .nf :global(.rec) { text-align: left; }
</style>

<script>
  // Open the search bar straight away, so the visitor can look for what they wanted.
  const btn = document.getElementById('search-btn');
  if (btn && btn.getAttribute('aria-expanded') !== 'true') btn.click();
</script>
