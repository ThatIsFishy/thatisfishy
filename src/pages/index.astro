---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NitrogenCycle from '../components/NitrogenCycle.astro';
import { TAGLINE, topicSlug } from '../consts';

type Dated = { data: { date: Date } };
const newest = (a: Dated, b: Dated) => b.data.date.valueOf() - a.data.date.valueOf();
const articles = (await getCollection('guides')).sort(newest).slice(0, 8);
const stories = (await getCollection('journal')).sort(newest).slice(0, 8);
---
<Base>
  <h1>{TAGLINE}</h1>
  <p class="lead">I’m a beginner too. This site holds what I learn, the mistakes I make, and the shops worth visiting. Read along, or start your first tank with me.</p>
  <div class="actions">
    <a class="btn" href="/knowledge-center/">Start learning</a>
    <a class="btn alt" href="/fishy-stories/">Read my Fishy Stories</a>
  </div>

  <svg class="wave" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 24 Q 50 6 100 24 T 200 24 T 300 24 T 400 24 T 500 24 T 600 24 T 700 24 T 800 24 T 900 24 T 1000 24 T 1100 24 T 1200 24" fill="none" stroke="var(--sand)" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    <path d="M0 16 Q 50 -2 100 16 T 200 16 T 300 16 T 400 16 T 500 16 T 600 16 T 700 16 T 800 16 T 900 16 T 1000 16 T 1100 16 T 1200 16" fill="none" stroke="var(--water)" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  </svg>

  <NitrogenCycle />

  <div class="section-head">
    <h2>Newest articles</h2>
    <a href="/knowledge-center/">See all articles →</a>
  </div>
  <div class="grid four">
    {articles.map((a) => (
      <a class="card" href={`/knowledge-center/${a.id}/`} data-t={topicSlug(a.data.topic)}>
        <div class="tags"><span class="tag" data-t={topicSlug(a.data.topic)}>{a.data.topic}</span></div>
        <h3>{a.data.title}</h3>
        <p>{a.data.description}</p>
      </a>
    ))}
  </div>

  <div class="section-head">
    <h2>Newest Fishy Stories</h2>
    <a href="/fishy-stories/">See all stories →</a>
  </div>
  <div class="grid four">
    {stories.map((s) => (
      <a class="card" href={`/fishy-stories/${s.id}/`}>
        <div class="tags"><span class="tag">{s.data.date.toISOString().slice(0, 10)}</span></div>
        <h3>{s.data.title}</h3>
        {s.data.description && <p>{s.data.description}</p>}
      </a>
    ))}
  </div>
</Base>
