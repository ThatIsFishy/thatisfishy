---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NitrogenCycle from '../components/NitrogenCycle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StoryCard from '../components/StoryCard.astro';
import Break1 from '../components/Break1.astro';
import Break3 from '../components/Break3.astro';
import GalleryRow from '../components/GalleryRow.astro';
import Notices from '../components/Notices.astro';
import HeadPhoto from '../components/HeadPhoto.astro';
import { getLabels, getPage, coverOf, introHtml } from '../lib/content';
import { TAGLINE } from '../consts';

type Dated = { data: { date: Date } };
const newest = (a: Dated, b: Dated) => b.data.date.valueOf() - a.data.date.valueOf();
const labels = await getLabels();
const articles = (await getCollection('guides')).sort(newest).slice(0, 8);
const stories = (await getCollection('journal')).sort(newest).slice(0, 8);
const { data } = await getPage('home');
const intro = await introHtml(data.intro);
const cover = coverOf(data);
---
<Base description={data.description ?? data.intro ?? TAGLINE} image={cover?.image}>
  <div class="band">
    <h1>{data.title}</h1>
    <div class:list={['head', { 'has-photo': cover }]}>
      <div class="head-text">
        {intro && <div class="lead" set:html={intro} />}
        <div class="actions">
          <a class="btn" href="/knowledge-center/">Knowledge Center</a>
          <a class="btn alt" href="/fishy-stories/">Read my Fishy Stories</a>
        </div>
      </div>
      {cover && <HeadPhoto cover={cover} title={data.title} />}
    </div>
  </div>
  <Break1 />

  <Notices />

  <NitrogenCycle />

  <div class="section-head">
    <h2><svg class="bub" aria-hidden="true"><use href="#bub" /></svg> Newest articles</h2>
    <a href="/knowledge-center/">See all articles →</a>
  </div>
  <div class="grid four">
    {articles.map((a) => <ArticleCard guide={a} labels={labels} />)}
  </div>

  <Break3 gap />
  <div class="section-head">
    <h2><svg class="bub" aria-hidden="true"><use href="#bub" /></svg> Newest Fishy Stories</h2>
    <a href="/fishy-stories/">See all stories →</a>
  </div>
  <div class="grid four">
    {stories.map((s) => <StoryCard story={s} />)}
  </div>

  <GalleryRow />
</Base>
