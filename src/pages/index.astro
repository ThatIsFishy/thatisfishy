---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NitrogenCycle from '../components/NitrogenCycle.astro';
import { TAGLINE, topicSlug } from '../consts';

const guides = (await getCollection('guides')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const entries = (await getCollection('journal')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
---
<Base>
  <h1>{TAGLINE}</h1>
  <p class="lead">I’m a beginner too. This site holds what I learn, the mistakes I make, and the shops worth visiting. Read along, or start your first tank with me.</p>
  <div class="actions">
    <a class="btn" href="/learn/">Start learning</a>
    <a class="btn alt" href="/journal/">Read my tank journal</a>
  </div>

  <svg class="wave" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 24 Q 50 6 100 24 T 200 24 T 300 24 T 400 24 T 500 24 T 600 24 T 700 24 T 800 24 T 900 24 T 1000 24 T 1100 24 T 1200 24" fill="none" stroke="var(--sand)" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    <path d="M0 16 Q 50 -2 100 16 T 200 16 T 300 16 T 400 16 T 500 16 T 600 16 T 700 16 T 800 16 T 900 16 T 1000 16 T 1100 16 T 1200 16" fill="none" stroke="var(--water)" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  </svg>

  <NitrogenCycle />

  <h2>Newest guides</h2>
  <div class="grid">
    {guides.map((g) => (
      <a class="card" href={`/learn/${g.id}/`} data-t={topicSlug(g.data.topic)}>
        <div class="tags"><span class="tag" data-t={topicSlug(g.data.topic)}>{g.data.topic}</span><span class="tag">{g.data.level}</span></div>
        <h3>{g.data.title}</h3>
        <p>{g.data.description}</p>
      </a>
    ))}
  </div>

  <h2>From the journal</h2>
  <div class="grid">
    {entries.map((e) => (
      <a class="card" href={`/journal/${e.id}/`}>
        <div class="tags"><span class="tag">{e.data.date.toISOString().slice(0, 10)}</span></div>
        <h3>{e.data.title}</h3>
        {e.data.description && <p>{e.data.description}</p>}
      </a>
    ))}
  </div>
</Base>
