---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GalleryTile from '../../components/GalleryTile.astro';
import { getGallery, getPage } from '../../lib/content';

const items = await getGallery();
const { data, Content } = await getPage('gallery');
// Render each explanation now, so the page can show it instantly on a click.
const details = await Promise.all(items.map(async (entry) => ({ entry, Body: (await render(entry)).Content })));
---
<Base title={data.title} description={data.description}>
  <h1>{data.title}</h1>
  <div class="lead"><Content /></div>

  {items.length === 0 ? (
    <div class="panel coming"><h2>Coming soon</h2><p>The first photos are on their way.</p></div>
  ) : (
    <div class="gallery" id="gallery">
      <div class="tiles">
        {items.map((entry) => <GalleryTile entry={entry} />)}
      </div>

      <!-- The explanation. Empty and hidden until a photo is clicked. -->
      <aside class="side" id="side" aria-live="polite" hidden></aside>
    </div>

    <!-- Hidden copies of every explanation; the script copies one into the side panel. -->
    <div hidden id="store">
      {details.map(({ entry, Body }) => (
        <article data-for={entry.id}>
          <button class="close" type="button" aria-label="Close explanation">×</button>
          <h2>{entry.data.title}</h2>
          <p class="meta">{entry.data.date.toISOString().slice(0, 10)}</p>
          <div class="side-photos">
            {entry.data.photos.map((p) => <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />)}
          </div>
          <div class="prose"><Body /></div>
          <p><a href={`/gallery/${entry.id}/`}>Open on its own page →</a></p>
        </article>
      ))}
    </div>
  )}
</Base>

<script>
  const wrap = document.getElementById('gallery');
  const side = document.getElementById('side');
  const store = document.getElementById('store');
  let current: string | null = null;

  function show(slug: string | null) {
    if (!wrap || !side || !store) return;
    wrap.querySelectorAll<HTMLElement>('.tile').forEach((t) =>
      t.classList.toggle('active', t.dataset.slug === slug)
    );
    const source = slug ? store.querySelector(`[data-for="${CSS.escape(slug)}"]`) : null;
    if (!source) {
      current = null;
      side.hidden = true;
      side.replaceChildren();
      wrap.classList.remove('open');
      if (location.hash) history.replaceState(null, '', location.pathname);
      return;
    }
    current = slug;
    side.replaceChildren(source.cloneNode(true));
    side.hidden = false;
    wrap.classList.add('open');
    history.replaceState(null, '', `#${slug}`);
    if (matchMedia('(max-width: 60rem)').matches) side.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  wrap?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.close')) { show(null); return; }
    const tile = target.closest<HTMLElement>('.tile');
    if (!tile) return;
    e.preventDefault();                       // no jump to the entry page
    show(current === tile.dataset.slug ? null : tile.dataset.slug ?? null);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && current) show(null); });

  // A link like /gallery/#my-photo opens that explanation straight away.
  if (location.hash.length > 1) show(decodeURIComponent(location.hash.slice(1)));
</script>
