---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EntryHead from '../../../components/EntryHead.astro';
import MainText from '../../../components/MainText.astro';
import GalleryTile from '../../../components/GalleryTile.astro';
import GalleryLightbox from '../../../components/GalleryLightbox.astro';
import { getGalleryLabels, getGallery, hasGalleryLabel, noticeOf, colorOf } from '../../../lib/content';

export async function getStaticPaths() {
  const labels = await getGalleryLabels();
  const items = await getGallery();
  return labels.map((label) => ({
    params: { label: label.id },
    props: { label, entries: items.filter((e) => hasGalleryLabel(e, label.id)) },
  }));
}
const { label, entries } = Astro.props;
const { Content } = await render(label);
const hasBody = Boolean(label.body?.trim());
// A label that has entries shows them, whatever notice is set: the notice only applies while the label is empty.
const head = entries.length > 0 ? { ...label.data, notice: 'none' } : label.data;
const notice = noticeOf(head);
const description = label.data.description ?? label.data.intro ?? `Aquarium photos: ${label.data.name.toLowerCase()}.`;
---
<Base title={label.data.name} description={description}>
  <p class="back"><a href="/gallery/">← Gallery</a></p>
  <h1 class="label-title" style={`--tc:${colorOf(label)}`}>{label.data.name}</h1>
  <EntryHead data={head} />
  {!notice && (
    <Fragment>
      {entries.length > 0 && (
        <div class="tiles" id="gallery">
          {entries.map((entry) => <GalleryTile entry={entry} />)}
        </div>
      )}
      {entries.length > 0 && <GalleryLightbox items={entries} />}
      <MainText hasBody={hasBody} before={entries.length > 0}><Content /></MainText>
    </Fragment>
  )}
</Base>
