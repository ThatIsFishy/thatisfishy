---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EntryHead from '../../../components/EntryHead.astro';
import MainText from '../../../components/MainText.astro';
import GalleryTile from '../../../components/GalleryTile.astro';
import { getGalleryLabels, getGallery, hasGalleryLabel, noticeOf } from '../../../lib/content';

export async function getStaticPaths() {
  const labels = await getGalleryLabels();
  const items = await getGallery();
  return labels.map((label) => ({
    params: { label: label.id },
    props: { label, entries: items.filter((e) => hasGalleryLabel(e, label.id)) },
  }));
}
const { label, entries } = Astro.props;
const { Content } = await render(label);
const hasBody = Boolean(label.body?.trim());
const notice = noticeOf(label.data);
const description = label.data.description ?? label.data.intro ?? `Aquarium photos: ${label.data.name.toLowerCase()}.`;
---
<Base title={label.data.name} description={description}>
  <p class="back"><a href="/gallery/">← Gallery</a></p>
  <h1>{label.data.name}</h1>
  <EntryHead data={label.data} />
  {!notice && (
    <Fragment>
      <MainText hasBody={hasBody}><Content /></MainText>
      {entries.length > 0 && (
        <div class="tiles">
          {entries.map((entry) => <GalleryTile entry={entry} />)}
        </div>
      )}
    </Fragment>
  )}
</Base>
