---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLabels, labelsOf } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const own = labelsOf(entry, await getLabels());
---
<Base title={entry.data.title} description={entry.data.description}>
  <p class="back"><a href="/knowledge-center/">← Knowledge Center</a></p>
  <h1>{entry.data.title}</h1>
  <div class="tags">
    {own.map((l) => <a class="tag" data-c={l.data.color} href={`/knowledge-center/label/${l.id}/`}>{l.data.name}</a>)}
  </div>
  <div class="prose"><Content /></div>
</Base>
