---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryHead from '../../components/EntryHead.astro';
import MainText from '../../components/MainText.astro';
import { getLabels, labelsOf } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const own = labelsOf(entry, await getLabels());
---
<Base title={entry.data.title} description={entry.data.description ?? entry.data.intro} index kind="Article">
  <div class="column">
    <p class="back" data-pagefind-ignore><a href="/knowledge-center/">← Knowledge Center</a></p>
    <h1>{entry.data.title}</h1>
    <EntryHead data={entry.data} labels={own} showDateByDefault />
    <MainText hasBody={Boolean(entry.body?.trim())}><Content /></MainText>
  </div>
</Base>
