---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubDates from '../../components/PubDates.astro';
import { getLabels, labelsOf, colorOf } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const own = labelsOf(entry, await getLabels());
---
<Base title={entry.data.title} description={entry.data.description} index kind="Article">
  <div class="column">
    <p class="back" data-pagefind-ignore><a href="/knowledge-center/">← Knowledge Center</a></p>
    <h1>{entry.data.title}</h1>
    <PubDates date={entry.data.date} updated={entry.data.updated} />
    <div class="tags">
      {own.map((l) => <a class="tag" data-c="" style={`--tc:${colorOf(l)}`} href={`/knowledge-center/label/${l.id}/`}>{l.data.name}</a>)}
    </div>
    <div class="prose"><Content /></div>
  </div>
</Base>
