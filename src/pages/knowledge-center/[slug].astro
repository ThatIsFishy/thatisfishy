---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryHead from '../../components/EntryHead.astro';
import MainText from '../../components/MainText.astro';
import NitrogenCycle from '../../components/NitrogenCycle.astro';
import Related from '../../components/Related.astro';
import { getLabels, labelsOf, noticeOf, coverOf } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const own = labelsOf(entry, await getLabels());
---
<Base title={entry.data.title} description={entry.data.description ?? entry.data.intro} index kind="Article" image={coverOf(entry.data)?.image}>
  <div class="column">
    <p class="back" data-pagefind-ignore><a href="/knowledge-center/">← Knowledge Center</a></p>
    <h1>{entry.data.title}</h1>
    <EntryHead data={entry.data} body={entry.body} labels={own} showDateByDefault />
    <MainText hasBody={Boolean(entry.body?.trim()) && !noticeOf(entry.data)}><Content /></MainText>
    {/* The nitrogen cycle article ends with the cycle tool, with the guide already open. */}
    {entry.id === 'what-is-the-nitrogen-cycle' && !noticeOf(entry.data) && <NitrogenCycle foldable={false} articleLink={false} />}
    {/* Always the last block of the page: new modules go above this line. */}
    {!noticeOf(entry.data) && <Related kind="article" id={entry.id} labels={entry.data.labels} />}
  </div>
</Base>
