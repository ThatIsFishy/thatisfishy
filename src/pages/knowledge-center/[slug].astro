---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { topicSlug } from '../../consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <p class="back"><a href="/knowledge-center/">← Knowledge Center</a></p>
  <h1>{entry.data.title}</h1>
  <div class="tags"><a class="tag" data-t={topicSlug(entry.data.topic)} href={`/knowledge-center/label/${topicSlug(entry.data.topic)}/`}>{entry.data.topic}</a></div>
  <div class="prose"><Content /></div>
</Base>
