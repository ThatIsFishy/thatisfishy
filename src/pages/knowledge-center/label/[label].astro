---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EntryHead from '../../../components/EntryHead.astro';
import MainText from '../../../components/MainText.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getLabels, hasLabel, noticeOf, colorOf, coverOf } from '../../../lib/content';

export async function getStaticPaths() {
  const labels = await getLabels();
  const guides = await getCollection('guides');
  return labels.map((label) => ({
    params: { label: label.id },
    props: {
      label,
      labels,
      guides: guides
        .filter((g) => hasLabel(g, label.id))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}
const { label, labels, guides } = Astro.props;
const { Content } = await render(label);
const hasBody = Boolean(label.body?.trim());
// A label that has guides shows them, whatever notice is set: the notice only applies while the label is empty.
const head = guides.length > 0 ? { ...label.data, notice: 'none' } : label.data;
const notice = noticeOf(head);
const description = label.data.description ?? label.data.intro ?? `Beginner articles about ${label.data.name.toLowerCase()}.`;
---
<Base title={label.data.name} description={description} image={coverOf(label.data)?.image}>
  <p class="back"><a href="/knowledge-center/">← Knowledge Center</a></p>
  <h1 class="label-title" style={`--tc:${colorOf(label)}`}>{label.data.name}</h1>
  <EntryHead data={head} />
  {!notice && (
    <Fragment>
      {guides.length > 0 && (
        <div class="grid">
          {guides.map((g) => <ArticleCard guide={g} labels={labels} />)}
        </div>
      )}
      <MainText hasBody={hasBody} before={guides.length > 0}><Content /></MainText>
    </Fragment>
  )}
</Base>
