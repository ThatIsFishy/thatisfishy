---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Break1 from '../../../components/Break1.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import NoticeLogo from '../../../components/NoticeLogo.astro';
import { getLabels, hasLabel } from '../../../lib/content';

export async function getStaticPaths() {
  const labels = await getLabels();
  const guides = await getCollection('guides');
  return labels.map((label) => ({
    params: { label: label.id },
    props: {
      label,
      labels,
      guides: guides
        .filter((g) => hasLabel(g, label.id))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}
const { label, labels, guides } = Astro.props;
const intro = label.data.description
  ?? (guides.length === 0 ? undefined : `${guides.length} ${guides.length === 1 ? 'article' : 'articles'} with this label.`);
const emptyMessage = label.data.emptyMessage ?? 'Articles with this label are on the way.';
---
<Base title={label.data.name} description={`Beginner articles about ${label.data.name.toLowerCase()}.`}>
  <p class="back"><a href="/knowledge-center/">← Knowledge Center</a></p>
  <h1>{label.data.name}</h1>
  {intro && <p class="lead">{intro}</p>}
  <Break1 />
  {guides.length === 0 ? (
    <div class="card empty-card">
      <NoticeLogo kind="empty" />
      <h3>Nothing here yet</h3>
      <p>{emptyMessage}</p>
    </div>
  ) : (
    <div class="grid">
      {guides.map((g) => <ArticleCard guide={g} labels={labels} />)}
    </div>
  )}
</Base>
