---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { TOPICS, topicSlug } from '../../../consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const extra = [...new Set(guides.map((g) => g.data.topic))].filter((t) => !TOPICS.includes(t));
  return [...TOPICS, ...extra].map((topic) => ({
    params: { label: topicSlug(topic) },
    props: {
      topic,
      guides: guides
        .filter((g) => g.data.topic === topic)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}
const { topic, guides } = Astro.props;
---
<Base title={topic} description={`Beginner articles about ${topic.toLowerCase()}.`}>
  <p class="back"><a href="/knowledge-center/">← Knowledge Center</a></p>
  <h1>{topic}</h1>
  <p class="lead">{guides.length === 0 ? 'No articles with this label yet. Coming soon.' : `${guides.length} ${guides.length === 1 ? 'article' : 'articles'} with this label.`}</p>
  <div class="grid">
    {guides.map((g) => (
      <a class="card" href={`/knowledge-center/${g.id}/`} data-t={topicSlug(g.data.topic)}>
        <div class="tags"><span class="tag" data-t={topicSlug(g.data.topic)}>{g.data.topic}</span></div>
        <h3>{g.data.title}</h3>
        <p>{g.data.description}</p>
      </a>
    ))}
  </div>
</Base>
