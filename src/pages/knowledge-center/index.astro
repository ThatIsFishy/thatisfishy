---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getLabels, getPage } from '../../lib/content';

const labels = await getLabels();
const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const { data, Content } = await getPage('knowledge-center');
---
<Base title={data.title} description={data.description}>
  <h1>{data.title}</h1>
  <div class="lead"><Content /></div>
  <div class="filters" role="group" aria-label="Filter articles by label">
    <button class="chip" type="button" data-filter="All" aria-pressed="true">All</button>
    {labels.map((l) => <button class="chip" type="button" data-filter={l.id} aria-pressed="false">{l.data.name}</button>)}
  </div>
  <div class="grid" id="list">
    {guides.map((g) => <ArticleCard guide={g} labels={labels} />)}
  </div>
  <p id="empty" hidden>No articles with this label yet. Coming soon.</p>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-labels]');
  const empty = document.getElementById('empty');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      let shown = 0;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach((card) => {
        const own = (card.dataset.labels ?? '').split('|');
        card.hidden = !(f === 'All' || own.includes(f ?? ''));
        if (!card.hidden) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    })
  );
</script>
