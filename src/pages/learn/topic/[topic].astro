---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { topicSlug } from '../../../consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const topics = [...new Set(guides.map((g) => g.data.topic))];
  return topics.map((topic) => ({
    params: { topic: topicSlug(topic) },
    props: {
      topic,
      guides: guides
        .filter((g) => g.data.topic === topic)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}
const { topic, guides } = Astro.props;
---
<Base title={topic} description={`Beginner guides about ${topic.toLowerCase()}.`}>
  <p class="back"><a href="/learn/">← All guides</a></p>
  <h1>{topic}</h1>
  <p class="lead">{guides.length} {guides.length === 1 ? 'guide' : 'guides'} in this topic.</p>
  <div class="grid">
    {guides.map((g) => (
      <a class="card" href={`/learn/${g.id}/`} data-t={topicSlug(g.data.topic)}>
        <div class="tags"><span class="tag" data-t={topicSlug(g.data.topic)}>{g.data.topic}</span><span class="tag">{g.data.level}</span></div>
        <h3>{g.data.title}</h3>
        <p>{g.data.description}</p>
      </a>
    ))}
  </div>
</Base>
