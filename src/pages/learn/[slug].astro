---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <p class="back"><a href="/learn/">← All guides</a></p>
  <h1>{entry.data.title}</h1>
  <div class="tags"><span class="tag">{entry.data.topic}</span><span class="tag">{entry.data.level}</span></div>
  <div class="prose"><Content /></div>
</Base>
