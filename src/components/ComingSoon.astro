---
// The notice card with its picture (builder shrimp or curtain): "Coming soon" or "Nothing here yet".
// Chosen per page, article or story in the CMS (Notice). The message is optional.
import NoticeLogo from './NoticeLogo.astro';
interface Props { kind?: 'coming' | 'empty'; message?: string; }
const { kind = 'coming', message } = Astro.props;
const title = kind === 'empty' ? 'Nothing here yet' : 'Coming soon';
const fallback = kind === 'empty' ? 'There is nothing here yet. Check back soon.' : 'This is not ready yet. Check back soon.';
---
<div class="card empty-card coming-card">
  <NoticeLogo kind={kind} />
  <h3>{title}</h3>
  <p>{message ?? fallback}</p>
</div>
