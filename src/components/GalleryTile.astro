---
import type { CollectionEntry } from 'astro:content';
import SourceBadge from './SourceBadge.astro';
import { getGalleryLabels, galleryLabelsOf, colorOf } from '../lib/content';

// One photo tile. It is a normal link to the entry page,
// and on the Gallery page a script turns the click into "open the big photo".
interface Props { entry: CollectionEntry<'gallery'>; home?: boolean; }
const { entry, home = false } = Astro.props;
const cover = entry.data.photos[0];
const count = entry.data.photos.length;
const own = galleryLabelsOf(entry, await getGalleryLabels());
---
<a class="tile" href={home ? `/gallery/#${entry.id}` : `/gallery/${entry.id}/`} data-slug={entry.id} data-src={cover.source} data-labels={entry.data.labels.join('|')}>
  <img src={cover.image} alt={cover.alt} loading="lazy" decoding="async" />
  <SourceBadge source={cover.source} />
  {count > 1 && <span class="count" aria-label={`${count} photos`}>{count} photos</span>}
  <span class="cap">
    {own.length > 0 && <span class="tl">{own.map((l) => <span class="tag" data-c="" style={`--tc:${colorOf(l)}`}>{l.data.name}</span>)}</span>}
    {entry.data.title}
  </span>
</a>
