---
// The picture on the Coming soon / Nothing here yet cards.
// "coming" = the builder shrimp at the tank, "empty" = the tank behind the curtain.
// Drawn once in Base.astro (#nl-base, #nl-curtain); the colours follow light and dark mode.
interface Props { kind?: 'coming' | 'empty'; }
const { kind = 'coming' } = Astro.props;
const curtain = kind === 'empty';
---
<svg class="nlogo" width={curtain ? 219 : 190} height="190" aria-hidden="true" focusable="false"><use href={curtain ? '#nl-curtain' : '#nl-base'} width="100%" height="100%" /></svg>
