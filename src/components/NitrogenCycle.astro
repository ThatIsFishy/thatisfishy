---
// The nitrogen cycle panel on the home page:
//   a slider over an example cycle in five stages (bars, or a graph with "Show as graph"),
//   a box with what happens / what you do / what you measure at that stage,
//   and "Is my tank fully cycled?": the visitor fills in their own test results and sees where they are.
// With foldable (default), the details (slider, bars/graph, stage box) starts closed with an "Open for more details" button;
// "Is my tank fully cycled?" is always open.
interface Props { foldable?: boolean; articleLink?: boolean; }
const { foldable = true, articleLink = true } = Astro.props;
---
<div class="panel" id="cycle">
  <h2 style="margin-top:0">The first thing every tank needs: the nitrogen cycle</h2>
  <p>A new tank has no helpful bacteria yet. Growing them usually takes several weeks. Below is an example of a typical cycle in five stages, with what to do at each stage and when your fish can move in.</p>
  {foldable && <p><button class="nc-fold" id="nc-fold" type="button" aria-expanded="false" aria-controls="nc-body">Open for more details ▾</button></p>}
  <div class="nc-body" id="nc-body" hidden={foldable}>
    <p class="nc-method">Your own cycling method decides when your aquarium is ready for fish: an ammonia source, and/or bottled bacteria, and/or filter media or water from an established aquarium. Yours can be faster or slower than this example.</p>

    <div class="nc-head">
      <span class="nc-day" id="nc-day"></span>
      <button class="nc-toggle" id="nc-toggle" type="button" aria-pressed="false">📈 Show as graph</button>
    </div>
    <input class="nc-slider" id="c-day" type="range" min="1" max="35" value="10" aria-label="Stage of the cycle" />

    <div class="nc-bars" id="nc-bars">
      <div class="row"><span><i class="dot d-nh3"></i>Ammonia</span><div class="track"><div class="fill" id="b-nh3" style="background:var(--warn)"></div></div><b id="v-nh3"></b></div>
      <div class="row"><span><i class="dot d-no2"></i>Nitrite</span><div class="track"><div class="fill" id="b-no2" style="background:var(--sand)"></div></div><b id="v-no2"></b></div>
      <div class="row"><span><i class="dot d-no3"></i>Nitrate</span><div class="track"><div class="fill" id="b-no3" style="background:var(--plant)"></div></div><b id="v-no3"></b></div>
    </div>
    <div class="nc-chart-wrap" id="nc-chart-wrap" hidden>
      <div class="nc-legend"><span><i class="dot d-nh3"></i>Ammonia</span><span><i class="dot d-no2"></i>Nitrite</span><span><i class="dot d-no3"></i>Nitrate</span></div>
      <svg class="nc-chart" id="chart" viewBox="0 18 900 160" role="img" aria-label="Ammonia, nitrite and nitrate over the five stages of a cycle"></svg>
    </div>

    <div class="nc-week" id="c-week"></div>
    <p class="note" style="margin-top:1rem">An example of a typical cycle, not a measurement. Real tanks vary, so test with a liquid kit.</p>
  </div>
  <div class="nc-check" data-checker></div>
  {articleLink && (
    <div class="nc-foot">
      <p class="more"><a href="/knowledge-center/what-is-the-nitrogen-cycle/">Read the full article</a></p>
    </div>
  )}
</div>

<style is:global>
  /* ---------- shared week info box ---------- */
  .nc-week { border: 1px solid var(--line); border-radius: 12px; background: var(--bg); padding: 1rem 1.1rem; }
  .nc-week h3 { margin: 0 0 .5rem; font-size: 1.2rem; }
  .nc-cols { display: grid; gap: .9rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 44rem) { .nc-cols { grid-template-columns: 1fr; } }
  .nc-cols h4 { margin: 0 0 .25rem; font: 600 .8rem var(--head); text-transform: uppercase; letter-spacing: .05em; color: var(--water); }
  .nc-cols p { margin: 0; font-size: .95rem; }
  .nc-read { list-style: none; margin: 0; padding: 0; display: grid; gap: .2rem; font-size: .92rem; }
  .nc-read li { display: flex; justify-content: space-between; gap: .6rem; }
  .nc-read b { font: 600 .9rem var(--head); }
  .dot { display: inline-block; width: .65rem; height: .65rem; border-radius: 50%; margin-right: .35rem; vertical-align: 0; }
  .d-nh3 { background: var(--warn); } .d-no2 { background: var(--sand); } .d-no3 { background: var(--plant); }

  /* ---------- idea 1: chart ---------- */
  .nc-chart { width: 100%; height: auto; display: block; overflow: visible; }
  .nc-chart .ax { stroke: var(--line); stroke-width: 1.5; }
  .nc-chart .wk { font: 500 12px var(--head); fill: var(--muted); text-anchor: middle; }
  .nc-chart .ph { opacity: .5; }
  .nc-chart .flag line { stroke: var(--muted); stroke-dasharray: 3 3; }
  .nc-chart .flag text { font: 600 11px var(--head); fill: var(--ink); }
  .nc-chart .fish line { stroke: var(--plant); stroke-width: 2; stroke-dasharray: none; }
  .nc-chart .fish text { fill: var(--plant); font-size: 12px; }
  .nc-chart.narrow .flag text, .nc-chart.narrow .wk { font-size: 19px; }
  .nc-chart .marker { stroke: var(--water); stroke-width: 2.5; }
  .nc-legend { display: flex; gap: 1rem; flex-wrap: wrap; font: 500 .9rem var(--head); margin: .3rem 0 .6rem; }
  .nc-slider { width: 100%; margin: .4rem 0 1rem; accent-color: var(--water); }


  /* ---------- idea 3: checker ---------- */
  .nc-check { margin-top: 1.4rem; border-top: 1px solid var(--line); padding-top: 1.2rem; }
  .nc-check h3 { margin: 0 0 .3rem; }
  .nc-check > p { margin: 0 0 .8rem; color: var(--muted); }
  .nc-fields { display: grid; gap: .8rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 44rem) { .nc-fields { grid-template-columns: 1fr; } }
  .nc-fields label { display: grid; gap: .3rem; font: 500 .95rem var(--head); }
  .nc-fields input { font: inherit; width: 100%; box-sizing: border-box; padding: .5rem .6rem; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
  .nc-result { margin-top: 1rem; border-radius: 12px; padding: .9rem 1.1rem; border: 2px solid var(--line); background: var(--surface); }
  .nc-result h4 { margin: 0 0 .3rem; font: 700 1.1rem var(--head); }
  .nc-result p { margin: .2rem 0 0; }
  .nc-result[data-tone="wait"] { border-color: var(--sand); }
  .nc-result[data-tone="go"] { border-color: var(--plant); }
  .nc-result[data-tone="start"] { border-color: var(--water); }
  .nc-result[data-tone="warn"] { border-color: var(--warn); }

  .nc-head { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; flex-wrap:wrap; margin:.6rem 0 .4rem; }
  .nc-day { font: 600 1.05rem var(--head); }
  .nc-toggle { font: 500 .9rem var(--head); padding: .4rem .9rem; border-radius: 99px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
  .nc-toggle:hover { border-color: var(--water); }
  .nc-bars { display: grid; gap: .6rem; margin: .4rem 0 1rem; }
  .nc-bars .row { grid-template-columns: 5.5rem 1fr 6.5rem; }
  .nc-bars .row b { font: 600 .9rem var(--head); text-align: right; }
  .nc-method { border-left: 4px solid var(--plant); padding: .2rem 1rem; color: var(--muted); margin: .2rem 0 1rem; }
  .nc-chart-wrap[hidden], .nc-bars[hidden] { display: none; }

  /* Open / close */
  .nc-fold { font: 600 .95rem var(--head); padding: .55rem 1.1rem; border-radius: 99px; border: 1px solid var(--water); background: var(--surface); color: var(--water); cursor: pointer; }
  .nc-fold:hover { background: color-mix(in srgb, var(--water) 10%, var(--surface)); }
  .nc-body[hidden] { display: none; }
  .nc-foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }
  .nc-foot .more { margin: 0; }
</style>

<script>

  const WEEKS = [
    { t: 'Stage 1: Cycling starts', happens: 'You add an ammonia source. There are no helpful bacteria yet, so ammonia builds up. Near the end of this stage the first bacteria start and a little nitrite appears.', todo: 'Keep the ammonia source going. Leave the filter running day and night. No water changes.', read: ['rising', 'appears', '0'] },
    { t: 'Stage 2: First bacteria at work', happens: 'The first bacteria eat the ammonia: it peaks and then drops. They turn it into nitrite, which keeps rising. At the end of this stage the first nitrate appears.', todo: 'Keep adding the ammonia source. Test every 2 to 3 days.', read: ['high, then dropping', 'rising', 'appears'] },
    { t: 'Stage 3: Nitrite peak', happens: 'Ammonia drops to 0. Nitrite peaks: that is normal and a good sign. Nitrate is rising. With bottled bacteria or media from an established tank, things often go faster.', todo: 'Keep adding the ammonia source. Do you measure 0 for both ammonia and nitrite? Then do a last check: add an ammonia source or a pinch of fish food and test again after 1 to 2 days. Still both 0? Your fish can move in.', read: ['dropping to 0', 'high', 'rising'], fish: true },
    { t: 'Stage 4: Almost there', happens: 'The second bacteria turn nitrite into nitrate. Nitrite falls to 0 and nitrate rises. At the end of this stage the tank is cycled.', todo: 'When ammonia and nitrite are both 0, do a last check: add an ammonia source or a pinch of fish food and test again after 1 to 2 days. Still both 0? Your tank is cycled.', read: ['0', 'dropping to 0', 'rising'], fish: true },
    { t: 'Stage 5: Fully cycled', happens: 'The tank is cycled. Nitrate keeps rising from all the ammonia that was turned over.', todo: 'Do a big water change so nitrate is under 20 ppm. Add a few fish, not all at once, and keep testing the first weeks.', read: ['0', '0', 'high (under 20 after the water change)'], fish: true },
  ];
  const ICON = ['d-nh3', 'd-no2', 'd-no3'], NAME = ['Ammonia', 'Nitrite', 'Nitrate'];
  function weekHtml(i: number) {
    const w = WEEKS[i];
    return `<h3>${w.t}</h3><div class="nc-cols">
      <div><h4>What happens</h4><p>${w.happens}</p></div>
      <div><h4>What you do</h4><p>${w.todo}</p></div>
      <div><h4>What you measure</h4><ul class="nc-read">${w.read.map((r, k) => `<li><span><i class="dot ${ICON[k]}"></i>${NAME[k]}</span><b>${r}</b></li>`).join('')}</ul></div>
    </div>`;
  }
  // The example in days 1 to 35. t = days since the start (day 1 = t 0).
  const D = 34;
  const sig = (d, m, w) => 1 / (1 + Math.exp(-(d - m) / w));
  // Shapes like a typical real cycle: a small ammonia hill, then a higher nitrite hill, then nitrate keeps rising.
  const bell = (d, m, a, b) => Math.exp(-((d - m) ** 2) / (2 * (d < m ? a : b) ** 2));
  // ease: 0 at t<=0, 1 at t>=1. Each curve is exactly 0 before it starts and after it ends.
  const ease = (t) => (t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t));
  const nh3 = (t) => 0.35 * bell(t, 8.5, 2.8, 2.6) * ease(t / 1.5) * (1 - ease((t - 12) / 3));     // day 1 to 16
  const no2 = (t) => 0.55 * bell(t, 15, 3.5, 5) * ease((t - 4) / 2) * (1 - ease((t - 24) / 4));    // day 5 to 29 (0 on day 29)
  const no3 = (t) => (t <= 11 ? 0 : 0.9 * Math.min(1, (t - 11) / 23) ** 1.5);                        // from day 12, keeps rising
  const PEAK = { nh3: 0.35, no2: 0.55, no3: 0.9 };
  const STAGES = ['Cycling starts', 'First bacteria at work', 'Nitrite peak', 'Almost there', 'Fully cycled'];
  const FLAGS = [[0, 'Start'], [5, 'Nitrite appears'], [15, 'Ammonia 0'], [28, 'Nitrite 0']];
  // The graph is wide and low on a computer, a bit taller on a phone. It is redrawn when the width changes a lot.
  const svg = document.getElementById('chart');
  let G = { W: 0, X0: 0, X1: 0, Y0: 0, Y1: 0 };
  const x = (t) => G.X0 + (t / D) * (G.X1 - G.X0), y = (v) => G.Y0 - v * (G.Y0 - G.Y1);
  const path = (f) => Array.from({ length: D * 2 + 1 }, (_, i) => { const t = i / 2; return `${i ? 'L' : 'M'}${x(t).toFixed(1)},${y(f(t)).toFixed(1)}`; }).join('');
  // A stage name under the graph: one line on a computer, split over two lines on a phone.
  function stageLabel(name, cx, top, narrow) {
    if (!narrow) return `<text class="wk" x="${cx}" y="${top}">${name}</text>`;
    const words = name.split(' '), half = Math.ceil(words.length / 2);
    const lines = words.length > 1 ? [words.slice(0, half).join(' '), words.slice(half).join(' ')] : [name];
    return `<text class="wk" x="${cx}" y="${top}">` + lines.map((l, i) => `<tspan x="${cx}" dy="${i ? '1.1em' : 0}">${l}</tspan>`).join('') + '</text>';
  }
  function draw() {
    const narrow = (svg.parentElement?.clientWidth || 900) < 600;
    const W = narrow ? 560 : 900;
    if (W === G.W) return;
    G = { W, X0: 18, X1: W - 10, Y1: narrow ? 52 : 42, Y0: narrow ? 185 : 150 };
    const bottom = narrow ? 42 : 10;
    svg.setAttribute('viewBox', `0 18 ${W} ${G.Y0 + bottom}`);
    svg.classList.toggle('narrow', narrow);
    svg.innerHTML =
      `<line class="ax" x1="${G.X0}" y1="${G.Y0}" x2="${G.X1}" y2="${G.Y0}"/>` +
      [1, 2, 3, 4, 5].map((w) => stageLabel(STAGES[w - 1], x(w * 7 - 3.5), G.Y0 + 22, narrow) + (w < 5 ? `<line class="ax" x1="${x(w * 7)}" y1="${G.Y0}" x2="${x(w * 7)}" y2="${G.Y0 + 6}"/>` : '')).join('') +
      FLAGS.map(([t, label]) => `<g class="flag"><line x1="${x(t)}" y1="${G.Y1 - 14}" x2="${x(t)}" y2="${G.Y0}"/><text x="${x(t) + 4}" y="${G.Y1 - 2}">${label}</text></g>`).join('') +
      `<path d="${path(nh3)}L${x(D)},${G.Y0}L${x(0)},${G.Y0}Z" fill="color-mix(in srgb, var(--warn) 22%, transparent)"/>` +
      `<path d="${path(no2)}L${x(D)},${G.Y0}L${x(0)},${G.Y0}Z" fill="color-mix(in srgb, var(--sand) 28%, transparent)"/>` +
      `<path d="${path(no3)}L${x(D)},${G.Y0}L${x(0)},${G.Y0}Z" fill="color-mix(in srgb, var(--plant) 20%, transparent)"/>` +
      `<path d="${path(nh3)}" fill="none" stroke="var(--warn)" stroke-width="3"/>` +
      `<path d="${path(no2)}" fill="none" stroke="var(--sand)" stroke-width="3"/>` +
      `<path d="${path(no3)}" fill="none" stroke="var(--plant)" stroke-width="3"/>` +
      `<line class="marker" id="mk" y1="${G.Y1 - 14}" y2="${G.Y0}"/>`;
  }
  const cday = document.getElementById('c-day');
  function setBar(k, v, label) { document.getElementById('b-' + k).style.width = (v <= 0.005 ? 0 : Math.min(100, v * 100)) + '%'; document.getElementById('v-' + k).textContent = label; }
  function upd() {
    const d = +cday.value, t = d - 1, w = Math.min(4, Math.floor(t / 7));
    draw();
    const mk = document.getElementById('mk'); mk.setAttribute('x1', x(t)); mk.setAttribute('x2', x(t));
    const lvl = (f, k) => f(t) / PEAK[k];
    // The word always matches the bar: 0 only when the bar is empty.
    const hill = (v, peakT) => v <= 0.005 ? '0' : v >= 0.7 ? 'high' : t < peakT ? 'rising' : 'dropping';
    setBar('nh3', lvl(nh3, 'nh3'), hill(lvl(nh3, 'nh3'), 8.5));
    setBar('no2', lvl(no2, 'no2'), hill(lvl(no2, 'no2'), 15));
    const n3 = lvl(no3, 'no3');
    setBar('no3', n3, n3 <= 0.005 ? '0' : n3 >= 0.7 ? 'high' : 'rising');
    document.getElementById('nc-day').textContent = `Stage ${w + 1} of 5 · ${STAGES[w]}`;
    document.getElementById('c-week').innerHTML = weekHtml(w);
  }
  cday.addEventListener('input', upd); upd();
  addEventListener('resize', upd);
  const tog = document.getElementById('nc-toggle');
  tog.addEventListener('click', () => {
    const on = tog.getAttribute('aria-pressed') !== 'true';
    tog.setAttribute('aria-pressed', String(on));
    tog.textContent = on ? '📊 Show as bars' : '📈 Show as graph';
    document.getElementById('nc-chart-wrap').hidden = !on;
    document.getElementById('nc-bars').hidden = on;
    upd();
  });

  // ---------- idea 3: "Is my tank ready?" ----------
  // The rules, from top to bottom (the first that fits is shown):
  //   all 0 -> not started · ammonia, no nitrite -> cycling starts · ammonia + nitrite -> first bacteria
  //   no ammonia, nitrite 1 or more -> nitrite peak · no ammonia, nitrite below 1 -> almost there
  //   no ammonia, no nitrite, some nitrate -> fully cycled (do the last check first)
  function verdict(a, n, t) {
    if (a === 0 && n === 0 && t === 0) return ['start', 'Not started yet', 'There is nothing to work with yet. Add an ammonia source (for example a pinch of fish food), then test again in 2 to 3 days.'];
    if (a > 0 && n === 0) return ['wait', 'Cycling starts: waiting for the first bacteria', 'Ammonia is there, but nothing is eating it yet. This is normal at the start. Keep the ammonia source going and test again in 2 to 3 days.'];
    if (a > 0 && n > 0) return ['wait', 'First bacteria at work', 'Ammonia is being turned into nitrite. Keep the ammonia source going and test again in 2 to 3 days. Not ready for fish yet.'];
    if (n >= 1) return ['wait', 'Nitrite peak', 'Ammonia is handled and nitrite is high. That is normal: the second bacteria need time. Keep the ammonia source going and test again in 2 to 3 days.'];
    if (n > 0) return ['wait', 'Almost there', 'Ammonia is handled and nitrite is low. Keep the ammonia source going and test again in 2 to 3 days. When nitrite reaches 0, do the last check.'];
    return ['go', 'Fully cycled', 'Ammonia and nitrite are 0. Do a last check: add an ammonia source or a pinch of fish food and test again after 1 to 2 days. Still both 0? Your fish can move in. Add a few, not all at once, and keep testing the first weeks.'];
  }
  document.querySelectorAll('[data-checker]').forEach((box) => {
    const field = (id, label, dot, ph) => `<label><span><i class="dot ${dot}"></i>${label} (ppm)</span><input data-k="${id}" type="text" inputmode="decimal" autocomplete="off" maxlength="7" placeholder="${ph}" /></label>`;
    box.innerHTML = `<h3>Is my tank fully cycled?</h3><p>Type in your own test results and see where you are.</p>
      <div class="nc-fields">${field('nh3', 'Ammonia', 'd-nh3', 'e.g. 0.25')}${field('no2', 'Nitrite', 'd-no2', 'e.g. 0')}${field('no3', 'Nitrate', 'd-no3', 'e.g. 10')}</div>
      <div class="nc-result" aria-live="polite"></div>`;
    const r = box.querySelector('.nc-result');
    const run = () => {
      // Accept 0.25 and 0,25. Empty or not a number = not filled in yet.
      const v = (key) => { const t = box.querySelector(`[data-k="${key}"]`).value.trim().replace(',', '.'); const n = t === '' ? NaN : Number(t); return n >= 0 ? n : NaN; };
      const a = v('nh3'), n = v('no2'), t = v('no3');
      if ([a, n, t].some(Number.isNaN)) {
        r.dataset.tone = 'start';
        r.innerHTML = `<h4>Fill in all three</h4><p>Type your ammonia, nitrite and nitrate results in ppm, as numbers (for example 0, 0.25 or 10).</p>`;
        return;
      }
      const [tone, h, p] = verdict(a, n, t);
      r.dataset.tone = tone; r.innerHTML = `<h4>${h}</h4><p>${p}</p>`;
    };
    // Keep each box to a realistic number: up to 3 digits, then . or , and up to 3 decimals (e.g. 160 or 0,25).
    box.addEventListener('input', (e) => {
      const el = e.target;
      if (el.matches?.('[data-k]')) {
        const m = el.value.replace(/[^0-9.,]/g, '').match(/^(\d{0,3})([.,]\d{0,3})?/);
        const clean = m ? m[1] + (m[2] ?? '') : '';
        if (clean !== el.value) el.value = clean;
      }
      run();
    });
    run();
  });

  // Open / close the whole tool (the home page starts closed, so it does not take much space)
  const fold = document.getElementById('nc-fold');
  const ncBody = document.getElementById('nc-body');
  fold?.addEventListener('click', () => {
    const open = ncBody!.hidden;
    ncBody!.hidden = !open;
    fold.setAttribute('aria-expanded', String(open));
    fold.textContent = open ? 'Close ▴' : 'Open for more details ▾';
    if (!open) document.getElementById('cycle')?.scrollIntoView({ block: 'nearest' });
  });
</script>
