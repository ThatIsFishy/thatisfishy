---
import { fmtDate } from '../lib/content';

// "Published 18 Nov 2026 · Updated 20 Nov 2026" in small type. "Updated" only shows when you fill it in the CMS.
interface Props { date: Date; updated?: Date; }
const { date, updated } = Astro.props;
---
<p class="dates" data-pagefind-ignore>Published {fmtDate(date)}{updated && <Fragment> · Updated {fmtDate(updated)}</Fragment>}</p>
