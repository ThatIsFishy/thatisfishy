---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import '@fontsource/oswald/400.css';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/600.css';
import '@fontsource/lora/700.css';
import SideBubbles from '../components/SideBubbles.astro';
import Break1 from '../components/Break1.astro';
import { SITE_NAME, SITE_URL, TAGLINE, START_YEAR, SHOW_SHOPS, SHOW_RATING } from '../consts';
import { getLabels, hasLabel, getGalleryLabels, hasGalleryLabel, colorOf, getAllPages, plainText } from '../lib/content';

// index: put this page in the site search. kind: the small label in search results. image: a picture for the result.
interface Props { title?: string; description?: string; noindex?: boolean; index?: boolean; kind?: string; image?: string; }
const { title, description: rawDescription = TAGLINE, noindex = false, index = false, kind = 'Page', image } = Astro.props;
// The description may come from the Introduction text, which can hold headings and links: use plain text.
const description = plainText(rawDescription) || TAGLINE;
const fullTitle = title ? `${title} – ${SITE_NAME}` : `${SITE_NAME} – ${TAGLINE}`;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE_URL).toString();

// The labels for the dropdown, with the number of articles each one has.
const guides = await getCollection('guides');
const menuLabels = (await getLabels()).map((label) => ({
  id: label.id,
  name: label.data.name,
  color: colorOf(label),
  count: guides.filter((g) => hasLabel(g, label.id)).length,
}));

// The same for the Gallery: its own labels, with the number of gallery entries each one has.
const galleryEntries = await getCollection('gallery');
const menuGalleryLabels = (await getGalleryLabels()).map((label) => ({
  id: label.id,
  name: label.data.name,
  color: colorOf(label),
  count: galleryEntries.filter((e) => hasGalleryLabel(e, label.id)).length,
}));

// Links come from the pages: each page says (Menu) whether it shows in the header, the footer or both, and its Position.
// Home and Search always come first. Shop Finder and Rating System follow the switches in consts.ts.
const allPages = await getAllPages();
const shown = (e: { id: string }) => (e.id === 'shops' ? SHOW_SHOPS : e.id === 'rating-system' ? SHOW_RATING : e.id !== 'home');
type NavItem = { href: string; label: string; sub?: 'knowledge-center' | 'gallery'; pos: number };
const nav: NavItem[] = [
  { href: '/', label: 'Home', pos: -1 },
  ...allPages
    .filter((e) => shown(e) && (e.menu === 'header' || e.menu === 'both'))
    .map((e) => ({ href: e.href, label: e.title, sub: e.id === 'knowledge-center' ? 'knowledge-center' as const : e.id === 'gallery' && menuGalleryLabels.length > 0 ? 'gallery' as const : undefined, pos: e.position })),
].sort((a, b) => a.pos - b.pos);
const footerLinks: { href: string; label: string; pos: number }[] = allPages
  .filter((e) => shown(e) && (e.menu === 'footer' || e.menu === 'both'))
  .map((e) => ({ href: e.href, label: e.title, pos: e.footerPosition }))
  .sort((a, b) => a.pos - b.pos);
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    {image && <meta property="og:image" content={new URL(image, SITE_URL).toString()} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><symbol id="bub" viewBox="0 0 28 28"><circle cx="14" cy="14" r="9" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17" cy="11" r="2.2" fill="currentColor" /></symbol>
      <!-- The notice logos (Coming soon = builder shrimp at the tank, Nothing here yet = tank behind the curtain). Colours come from the page, so they follow light and dark mode. -->
      <symbol id="nl-base" viewBox="110 28 130 130"><g fill="none"><rect x="135" y="65" width="100" height="62" rx="10" stroke="currentColor" stroke-width="4"/><path d="M137 77H233" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M140 131L152 71M160 131L172 71M142.4 119H162.4M144.8 107H164.8M147.2 95H167.2M149.6 83H169.6"/></g><g transform="translate(126.7 32.9) scale(0.7)"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g transform="translate(0 4)"><path d="M38 55.3L34 61L36 65.5M43 55.3L40 61.5L42 65.5M48 53.8L47 60L50 65.5M52.5 50.5L55 57.5L58 65.5" stroke-width="1.7"/><path d="M55 40L61.5 38.3M54.6 46.5L62.5 45" stroke-width="1.7"/><path d="M17.5 54.5C15 56 14.5 58.5 15.5 61M22 55C19.5 56.5 19 59 20 61.5M26.5 55.5C24 57 23.5 59.5 24.5 62M31 56C28.5 57.5 28 60 29 62.5" stroke-width="1.4"/><path d="M68 20C62 11 48 8 41 16C36 24 37 36 40 44C33 48 22 49 14 47L10 40L7 44L5 50L1 55L14 53C22 55 34 56 44 55C52 53 55 46 55 38C55 30 54 24 52 21C58 20 63 20 68 20Z" style="fill:var(--surface)"/><path d="M39.3 28C42.5 28.5 46 30 48.5 32.5M47 41C49 43 50 45 50.3 48.5" stroke-width="1.4"/><path d="M18 48L18.3 54M22.5 48.6L23 54.8M27 48.6L27.6 55.3M31.5 48.2L32 55.7M36 46.5L36.8 55.8" stroke-width="1.4"/><path d="M14 50L9 44M14 50.5L5 50.5M14 51L3 54" stroke-width="1.2"/><g transform="rotate(-7 67.5 35)"><rect x="61" y="25" width="13" height="20" style="fill:var(--surface)"/><path d="M69.5 25L74 29.5M69.5 25V29.5H74" stroke-width="1.4"/></g><circle cx="51.5" cy="19" r="2.5" fill="currentColor"/></g><path d="M68 24C77 19 87 14 97 9M68 24C78 22 90 20.5 99 21" stroke-width="1.2"/><path d="M68 24C72 21 75 19.5 79 18.8M68 24C72 26.5 75.5 27.7 80 28" stroke-width="1.2"/><g transform="translate(0 0)"><path d="M36 15.8C48 18.2 62 17.6 74 14.4C65 12.2 46 12.4 36 15.8Z" style="fill:var(--surface)" stroke-width="1.6"/><path d="M37 14C37 4 45 0.8 52 0.8C60 0.8 65.5 6 65.5 13.5C55 12 45 12 37 14Z" style="fill:var(--surface)" stroke-width="1.8"/><path d="M40.5 12C41.5 6.5 46 3.8 52 3.3C57.5 3.3 62 7 63 12" stroke-width="1.4"/><path d="M42.5 9.5V12M45 7.8V11M60 8V11.5" stroke-width="1.2"/></g></g></g><g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M224 131V86L179 131Z" style="fill:var(--surface)"/><path d="M216 123V105L198 123Z"/></g><path d="M224 126H221.5M224 121H219.5M224 116H221.5M224 111H219.5M224 106H221.5M224 101H219.5M224 96H221.5M219 131V128.5M214 131V126.5M209 131V128.5M204 131V126.5M199 131V128.5M194 131V126.5M189 131V128.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><g transform="translate(-8 0) rotate(-4 235 143) translate(0 -4)" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d="M167 147L176 142.5V151.5Z"/><path d="M167 147L170 145.5V148.5Z" fill="currentColor"/><rect x="176" y="142.5" width="48" height="9"/><path d="M176 147H224" stroke-width="1.2"/><rect x="224" y="142.5" width="6" height="9"/><path d="M227 142.5V151.5" stroke-width="1.2"/><rect x="230" y="142.5" width="5" height="9" rx="2"/></g></g></symbol>
      <symbol id="nl-curtain" viewBox="110 28 150 130"><g fill="none"><rect x="135" y="65" width="100" height="62" rx="10" fill="none" stroke="currentColor" stroke-width="4"/><g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" fill="none"><path d="M126 57V127M244 57V127" stroke-width="3"/><path d="M128 58H242V118Q236 123 230 118T218 118T206 118T194 118T182 118T170 118T158 118T146 118T134 118L128 118Z" style="fill:var(--surface)" stroke-width="2.5"/><path d="M146 61C144 80 148 100 146 117M165 61C163 80 167 100 165 117M185 58V118M205 61C203 80 207 100 205 117M224 61C222 80 226 100 224 117" stroke-width="1.4"/><path d="M120 57H250" stroke-width="3.2"/></g><g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M140 131L152 71M160 131L172 71M142.4 119H162.4M144.8 107H164.8M147.2 95H167.2M149.6 83H169.6"/></g><g transform="translate(126.7 32.9) scale(0.7)"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g transform="translate(0 4)"><path d="M38 55.3L34 61L36 65.5M43 55.3L40 61.5L42 65.5M48 53.8L47 60L50 65.5M52.5 50.5L55 57.5L58 65.5" stroke-width="1.7"/><path d="M55 40L61.5 38.3M54.6 46.5L62.5 45" stroke-width="1.7"/><path d="M17.5 54.5C15 56 14.5 58.5 15.5 61M22 55C19.5 56.5 19 59 20 61.5M26.5 55.5C24 57 23.5 59.5 24.5 62M31 56C28.5 57.5 28 60 29 62.5" stroke-width="1.4"/><path d="M68 20C62 11 48 8 41 16C36 24 37 36 40 44C33 48 22 49 14 47L10 40L7 44L5 50L1 55L14 53C22 55 34 56 44 55C52 53 55 46 55 38C55 30 54 24 52 21C58 20 63 20 68 20Z" style="fill:var(--surface)"/><path d="M39.3 28C42.5 28.5 46 30 48.5 32.5M47 41C49 43 50 45 50.3 48.5" stroke-width="1.4"/><path d="M18 48L18.3 54M22.5 48.6L23 54.8M27 48.6L27.6 55.3M31.5 48.2L32 55.7M36 46.5L36.8 55.8" stroke-width="1.4"/><path d="M14 50L9 44M14 50.5L5 50.5M14 51L3 54" stroke-width="1.2"/><g transform="rotate(-7 67.5 35)"><rect x="61" y="25" width="13" height="20" style="fill:var(--surface)"/><path d="M69.5 25L74 29.5M69.5 25V29.5H74" stroke-width="1.4"/></g><circle cx="51.5" cy="19" r="2.5" fill="currentColor"/></g><path d="M68 24C77 19 87 14 97 9M68 24C78 22 90 20.5 99 21" stroke-width="1.2"/><path d="M68 24C72 21 75 19.5 79 18.8M68 24C72 26.5 75.5 27.7 80 28" stroke-width="1.2"/><g transform="translate(0 0)"><path d="M36 15.8C48 18.2 62 17.6 74 14.4C65 12.2 46 12.4 36 15.8Z" style="fill:var(--surface)" stroke-width="1.6"/><path d="M37 14C37 4 45 0.8 52 0.8C60 0.8 65.5 6 65.5 13.5C55 12 45 12 37 14Z" style="fill:var(--surface)" stroke-width="1.8"/><path d="M40.5 12C41.5 6.5 46 3.8 52 3.3C57.5 3.3 62 7 63 12" stroke-width="1.4"/><path d="M42.5 9.5V12M45 7.8V11M60 8V11.5" stroke-width="1.2"/></g></g></g><g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M224 131V86L179 131Z" style="fill:var(--surface)"/><path d="M216 123V105L198 123Z" fill="none"/></g><path d="M224 126H221.5M224 121H219.5M224 116H221.5M224 111H219.5M224 106H221.5M224 101H219.5M224 96H221.5M219 131V128.5M214 131V126.5M209 131V128.5M204 131V126.5M199 131V128.5M194 131V126.5M189 131V128.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><g transform="translate(-8 0) rotate(-4 235 143) translate(0 -4)" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d="M167 147L176 142.5V151.5Z"/><path d="M167 147L170 145.5V148.5Z" fill="currentColor"/><rect x="176" y="142.5" width="48" height="9"/><path d="M176 147H224" stroke-width="1.2"/><rect x="224" y="142.5" width="6" height="9"/><path d="M227 142.5V151.5" stroke-width="1.2"/><rect x="230" y="142.5" width="5" height="9" rx="2"/></g></g></symbol></svg>
    <a class="skip" href="#main">Skip to content</a>
    <!-- .top keeps the header and the search bar stuck to the top as two separate layers,
         so each one blurs the page behind it on its own. -->
    <div class="top">
    <header class="site">
      <div class="bar">
        <a class="logo" href="/"><img src="/favicon.svg" alt="" width="36" height="36" />{SITE_NAME}</a>
        <nav class="main" aria-label="Main">
          <button class="search-btn" id="search-btn" type="button" aria-label="Search the site" aria-expanded="false" aria-controls="searchbar">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
          </button>
          {nav.map((n) =>
            n.sub ? (
              <div class="has-sub">
                <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>
                <div class="sub">
                  <ul>
                    {(n.sub === 'gallery' ? menuGalleryLabels : menuLabels).map((l) => (
                      <li>
                        <a href={`/${n.sub === 'gallery' ? 'gallery' : 'knowledge-center'}/label/${l.id}/`} data-c="" style={`--tc:${l.color}`}>
                          {l.name}<span>{l.count > 0 ? l.count : 'soon'}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>
            )
          )}
        </nav>
        <button class="theme" id="theme" type="button" aria-label="Switch between light and dark mode">
          <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="currentColor" /></svg>
          <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        </button>
      </div>

    </header>
    <!-- Search bar: slides down under the header when the magnifier is clicked -->
    <div class="searchbar" id="searchbar" hidden>
      <div class="search-inner">
        <label class="sr" for="search-input">Search the site</label>
        <input id="search-input" type="search" placeholder="Search words or a short phrase…" autocomplete="off" />
        <div class="filters s-filters" id="search-filters" role="group" aria-label="Show only" hidden></div>
        <div id="search-results" aria-live="polite"></div>
      </div>
    </div>
    </div>
    <main id="main" data-pagefind-body={index ? '' : undefined} data-pagefind-meta={index ? `type:${kind}` : undefined} data-pagefind-filter={index ? 'type[data-kind]' : undefined} data-kind={index ? kind : undefined}>
      {index && image && <span hidden data-pagefind-meta={`image:${image}`}></span>}
      <slot />
    </main>
    <SideBubbles />
    <footer class="site">
      <Break1 />
      <nav class="footer-links" aria-label="Footer">
        {footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <p>© <span id="years" data-start={START_YEAR}>{START_YEAR}</span> {SITE_NAME}</p>
    </footer>
    <script>
      const btn = document.getElementById('theme');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      // ----- Search (uses Pagefind, an index made when the site is built) -----
      const sBtn = document.getElementById('search-btn') as HTMLButtonElement | null;
      const sBar = document.getElementById('searchbar');
      const sInput = document.getElementById('search-input') as HTMLInputElement | null;
      const sOut = document.getElementById('search-results');
      let pagefind: any = null;
      let timer: number | undefined;

      function setOpen(open: boolean) {
        if (!sBar || !sBtn) return;
        sBar.hidden = !open;
        sBtn.setAttribute('aria-expanded', String(open));
        if (open) sInput?.focus();
      }

      async function load() {
        if (pagefind) return pagefind;
        // The path is in a variable so the build tool leaves it alone; the file is made after the build.
        const path = '/pagefind/pagefind.js';
        pagefind = await import(/* @vite-ignore */ path);
        await pagefind.options({ baseUrl: '/' });
        await pagefind.filters();   // load the filter data first, so result counts per kind are available
        return pagefind;
      }

      const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

      // The kinds of result a visitor can filter on, in this order, with the names shown on the buttons.
      const KINDS: Record<string, string> = {
        Article: 'Knowledge Center', Story: 'Fishy Stories', Gallery: 'Gallery', Page: 'Info pages', 'Shop Finder': 'Shop Finder',
      };
      const selected = new Set<string>();   // nothing selected = "All"
      const STEP = 8;                       // results shown at first, and per click on "Show more"
      let shown = STEP;
      const sFilters = document.getElementById('search-filters');

      async function run(keepShown = false) {
        const term = (sInput?.value ?? '').trim();
        if (!sOut) return;
        if (!keepShown) shown = STEP;
        if (term.length < 2) { sOut.innerHTML = ''; if (sFilters) sFilters.hidden = true; return; }
        if (!pagefind) sOut.innerHTML = '<div class="s-load"><div class="rise" aria-hidden="true"><svg class="bub"><use href="#bub"></use></svg><svg class="bub"><use href="#bub"></use></svg><svg class="bub"><use href="#bub"></use></svg></div><span>Searching…</span></div>';
        try {
          const pf = await load();

          // 1. Count the results per kind for this word (without any filter).
          const base = await pf.search(term);
          const counts: Record<string, number> = base.filters?.type ?? {};
          const total = Object.values(counts).reduce((a, b) => a + b, 0);

          // 2. A selected kind that has no results for this word is dropped from the selection.
          for (const k of [...selected]) if (!(counts[k] > 0)) selected.delete(k);

          // 3. Draw the buttons: all kinds, pale and disabled when there is nothing in them.
          if (sFilters) {
            const chip = (k: string, label: string, n: number, on: boolean, off: boolean) =>
              `<button class="chip" type="button" data-kind="${esc(k)}" aria-pressed="${on}"${off ? ' disabled' : ''}><svg class="bub dot" aria-hidden="true"><use href="#bub"></use></svg>${esc(label)} <span class="s-n">${n}</span></button>`;
            sFilters.innerHTML =
              chip('All', 'All', total, selected.size === 0, false) +
              Object.keys(KINDS).map((k) => chip(k, KINDS[k], counts[k] ?? 0, selected.has(k), !(counts[k] > 0))).join('');
            sFilters.hidden = false;
          }

          // 4. The results: everything, or only the selected kinds.
          const found = selected.size === 0 ? base : await pf.search(term, { filters: { type: { any: [...selected] } } });
          if (found.results.length === 0) { sOut.innerHTML = `<div class="s-empty"><div class="cl" aria-hidden="true"><svg class="bub lg c1"><use href="#bub"></use></svg><svg class="bub sm c2"><use href="#bub"></use></svg><svg class="bub c3"><use href="#bub"></use></svg></div><p>Nothing found for “${esc(term)}”. Try another word.</p></div>`; return; }
          const top = await Promise.all(found.results.slice(0, shown).map((r: any) => r.data()));
          const more = found.results.length - top.length;
          sOut.innerHTML = '<ul>' + top.map((d: any) => `
            <li><a href="${d.url}">
              ${d.meta.image ? `<img src="${esc(d.meta.image)}" alt="" loading="lazy" />` : ''}
              <span class="s-text"><span class="s-kind">${esc(KINDS[d.meta.type] ?? d.meta.type ?? 'Page')}</span>
              <strong>${esc(d.meta.title ?? '')}</strong>
              <span class="s-ex">${d.excerpt}</span></span>
            </a></li>`).join('') + '</ul>'
            + (more > 0 ? `<p class="s-more"><button class="chip" type="button" data-more>Show more <span class="s-n">${more} left</span></button></p>` : '');
        } catch (err) {
          sOut.innerHTML = '<p class="s-empty">Search is only available on the built site (not in <code>npm run dev</code>).</p>';
        }
      }

      // Clicking a button: All clears the selection; a kind is switched on or off.
      // When the last kind is switched off, the selection is empty again, which means All.
      sFilters?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-kind]');
        if (!btn || btn.disabled) return;
        const k = btn.dataset.kind ?? 'All';
        if (k === 'All') selected.clear();
        else if (selected.has(k)) selected.delete(k);
        else selected.add(k);
        run();
        sInput?.focus();
      });
      sOut?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-more]')) { shown += STEP; run(true); }
      });

      sBtn?.addEventListener('click', () => setOpen(sBar?.hidden ?? true));
      sInput?.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(() => run(), 150); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && sBar && !sBar.hidden) { setOpen(false); sBtn?.focus(); } });
      document.addEventListener('click', (e) => {
        const t = e.target as Node;
        if (sBar && !sBar.hidden && !sBar.contains(t) && !sBtn?.contains(t)) setOpen(false);
      });

      // Footer year: "2026" in 2026, "2026 – 2027" in 2027, and so on.
      const years = document.getElementById('years');
      if (years) {
        const start = Number(years.dataset.start);
        const now = new Date().getFullYear();
        years.textContent = now > start ? `${start} – ${now}` : String(start);
      }
    </script>
  </body>
</html>
